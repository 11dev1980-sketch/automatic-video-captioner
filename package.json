{
  "name": "automatic-video-captioner",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "expo": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 6744",
    "build": "echo 'Use build-web for web build'",
    "build-web": "npx expo export --platform web",
    "prebuild": "expo prebuild && echo \"prebuild complete\"",
    "test": "node node_modules/jest/bin/jest.js",
    "verify-api": "node scripts/verify-api-setup.js",
    "generate-icons": "node generate-icons.js",
    "version": "node scripts/version-manager.js",
    "version:patch": "node scripts/version-manager.js",
    "version:minor": "node scripts/version-manager.js",
    "version:major": "node scripts/version-manager.js",
    "api": "node server.js",
    "dev": "concurrently \"npm run api\" \"npm run web\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@expo/vector-icons": "^15.1.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/stack": "^7.6.12",
    "axios": "^1.13.2",
    "expo": "~53.0.0",
    "expo-audio": "~0.2.3",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~2.0.3",
    "googleapis": "^181.0.0",
    "lz-string": "^1.5.0",
    "multer": "^2.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.13"
