    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "eas-cli": "^18.5.0",
    "express": "^4.21.2",
    "fast-check": "^4.8.0",
    "jest": "^30.2.0",
    "jest-expo": "^47.0.1",
    "react-test-renderer": "^19.1.0",
    "sharp": "^0.33.0",
    "typescript": "^7.0.2"
  },
