# Supadata Configuration (Transcription)
# Format: Multiple keys can be separated by commas for rotation
# Example: SUPADATA_API_KEY=key1,key2,key3
# Only the first key is used by default, rotates to next on rate limit (429, 502, 503, 504)
SUPADATA_API_KEY=your_supadata_key_here

# Google AI Studio Configuration (Translation)
# Format: Multiple keys can be separated by commas for rotation
# Example: GOOGLE_AI_STUDIO_API_KEY=key1,key2,key3
# Only the first key is used by default, rotates to next on rate limit (429, 502, 503, 504)
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here

# RapidAPI Configuration (Video Download from Instagram, TikTok, etc.)
# Format: Multiple keys can be separated by commas for rotation
# Example: RAPIDAPI_KEY=key1,key2,key3
# Only the first key is used by default, rotates to next on rate limit (401, 403, 429)
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Drive Configuration (File Hosting)
# Path to the service account JSON key file (relative to project root)
# Download this from Google Cloud Console > Credentials > Service Account > Keys
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=service-account-key.json

# Optional: Custom transcription endpoint
# EXPO_PUBLIC_TRANSCRIBE_ENDPOINT=https://your-custom-endpoint.com/api/transcribe
